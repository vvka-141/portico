<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Portico.Hosting</RootNamespace>
    <AssemblyName>Portico.Hosting</AssemblyName>
    <PackageId>Portico.Hosting</PackageId>
    <Description>
      Generic Host integration for Portico. Your service already has a HostApplicationBuilder, its
      configuration, its logging and its container — its admin CLI should reuse them, not rebuild
      them. Graceful shutdown defers to the host's lifetime; the command's exit code reaches Main.
    </Description>
    <PackageTags>cli;command-line;generic-host;hosting;portico</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portico\Portico.csproj" />
    <ProjectReference Include="..\Portico.DependencyInjection\Portico.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
