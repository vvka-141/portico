<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Portico.DependencyInjection</RootNamespace>
    <AssemblyName>Portico.DependencyInjection</AssemblyName>
    <PackageId>Portico.DependencyInjection</PackageId>
    <Description>
      Microsoft.Extensions.DependencyInjection integration for Portico, the contract-first CLI
      framework for .NET. Resolve command contracts and middleware from an IServiceProvider, with
      one IServiceScope per dispatched command. Command services stay lazy, and scoped resources
      are disposed after success, failure or cancellation. The core Portico package stays
      dependency-free; this is the opt-in.
    </Description>
    <PackageTags>portico;cli;command-line;dotnet;dependency-injection;di;iserviceprovider;service-scope;console</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The ONLY dependency, and it is Abstractions on purpose: an adapter that pulled the full
      DI implementation would force a container on consumers who already have one.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PrivateAssets="none" is load-bearing (POR-53). NuGet's DEFAULT for a package dependency is
      PrivateAssets="contentfiles;analyzers;build" — it does not flow analyzer assets transitively.
      Without this, `dotnet add package Portico.DependencyInjection` gives you the framework with
      POR001–POR010 silently switched off: a green build, and none of the compile-time checks the
      README promises. Verified by consuming the packed .nupkg, not by reading the nuspec.
    -->
    <ProjectReference Include="..\Portico\Portico.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Portico.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
