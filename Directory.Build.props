<Project>

  <!--
    Shared conventions for every project in the Portico solution.

    Per-project csproj files declare only what is project-specific:
      PackageId, Title, Description, PackageTags
      <PackageReference> and <ProjectReference>
    Everything else — identity, license, package shape, reproducible-build
    settings — lives here. Third-party versions live in Directory.Packages.props.
  -->

  <PropertyGroup Label="Version">
    <!--
      The version is derived from the git tag by MinVer — there is no hand-edited version
      property, and adding one back would silently override the tag. Tag `v0.2.0` produces
      0.2.0; with no tag in history you get 0.0.0-alpha.0.N, which is the correct
      pre-first-release answer, not something to paper over.

      Consequence for CI: any checkout that packs MUST use fetch-depth: 0. A shallow clone
      has no tag history, so MinVer would quietly compute the wrong version.
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup Label="Version">
    <!--
      PrivateAssets="all": MinVer runs at build time only and never becomes a package
      dependency. The produced nupkg's dependency group stays empty — verified by unzipping
      it, and by Portico_Package_Should.HaveNoDependencies, which walks the built assembly's
      referenced assemblies.

      Note: `dotnet list package` on src/Portico WILL now list MinVer, because it reports
      top-level PackageReferences regardless of PrivateAssets. That is a reporting artifact,
      not a dependency — check the nupkg, not the list.
    -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Label="Language">
    <!--
      net8.0 + net10.0 (POR-78). This repo's rule used to be "net10.0 only, no multi-targeting until
      a real user asks" — a YAGNI rule that cannot work here, because the TFM is what stops the user
      arriving. A team on .NET 8 does not file an issue saying the framework requirement excluded
      them; they read the NuGet page and close the tab. Unlike the AOT deferral, which a user can
      still install the package and complain about, this one produces silence, and silence reads as
      "no demand".

      The cost turned out to be two lines, not a maintenance burden: no #if anywhere, and both
      targets ship the same zero-dependency package. Analyzer projects override this with
      TargetFrameworks=netstandard2.0, as Roslyn requires.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Explicit usings are the house style, inherited from the origin source. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Identity">
    <Authors>Alexey Evlampiev</Authors>
    <Company>Portico</Company>
    <Copyright>© Alexey Evlampiev. All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="Repository">
    <PackageProjectUrl>https://github.com/vvka-141/portico</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vvka-141/portico</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="License">
    <!--
      Apache-2.0, not MPL-2.0. Portico is a library linked into proprietary
      backend services; Apache's explicit patent grant is the reflex-safe choice
      for that audience. Acceptance is not required — permissive licenses that
      demand a click read as encumbered.
    -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Label="PackageShape">
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
    <!-- Embedded, not PackageIconUrl: that one is deprecated and renders nothing on nuget.org. -->
    <PackageIcon>portico-icon-128.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Quiet the "no XML docs" noise without losing the generated doc file. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible build">
    <!-- Source-link ships in the SDK; no package reference is needed for it. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Local builds keep their dirty-tree behaviour. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Label="Pack the per-package README"
             Condition="'$(IsPackable)' != 'false'">
    <None Include="PACKAGE-README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <!--
      One icon for all four packages, generated from eng/brand/generate.py. NuGet recommends
      128x128 and caps embedded icons at 1 MB; this one is ~3 KB, because the source is geometry
      rather than a raster nobody can edit.
    -->
    <None Include="$(MSBuildThisFileDirectory)eng/brand/portico-icon-128.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

</Project>
