<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Portico.Templates</PackageId>
    <Title>Portico CLI template</Title>
    <Description>dotnet new template for Portico, the contract-first CLI framework for .NET. The "dotnet new portico-cli" command scaffolds a runnable net8.0 or net10.0 command-line application with an attributed route, a documented example, and passing contract tests that run that example through the real dispatch pipeline. The point is the loop: the example cannot drift from the CLI you shipped without turning a test red.</Description>
    <PackageTags>portico;cli;command-line;dotnet-new;project-template;console-application;net8;net10;testing</PackageTags>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!--
      A template package carries no assemblies. Everything below keeps the SDK from treating it as a
      library: nothing to compile, nothing to reference, no doc file to generate.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      The repo turns symbol packages on for its libraries. A template package has no assemblies, so
      the .snupkg pack fails with NU5017 ("no dependencies nor content") — and it fails AFTER writing
      a perfectly good .nupkg, which makes it look like a warning when it is a build failure.
    -->
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PackagePath is explicit: ContentTargetFolders alone would nest these at content/content/…,
      and `dotnet new` would then find no template at all. The package must lay the files out as
      content/PorticoCli/… — verified by unzipping the nupkg and by scaffolding from it.
    -->
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**"
             PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
