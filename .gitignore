# Build output
bin/
obj/
artifacts/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
.idea/

# Test / coverage artifacts
TestResults/
coverage.*
*.coverage
*.trx

# NuGet
*.nupkg
*.snupkg
packages/

# Hugo website build artifacts
website/public/
website/resources/
.hugo_build.lock

# env file
.env

# Claude Code artifacts (proprietary - keep locally only)
.claude/

# Other coding-assistant artifacts (keep locally only)
.agents/
.codex/

# Coding-assistant instructions (proprietary - keep locally only)
# Root-anchored: unanchored names would also silently hide any CLAUDE.md/
# AGENTS.md added under templates or example projects
/CLAUDE.md
/AGENTS.md

# Private assets (code reviews, design docs, change requests, competitive notes)
.private/

# Content and articles (local drafts, not tracked)
/content/

# .NET SDK first-use sentinels, when a sandbox or CI harness points DOTNET_CLI_HOME at the repo
# root. Nothing here creates this — it is an artefact of how the tooling is invoked — but an
# untracked directory that appears whenever tests run is how unrelated junk eventually gets
# committed. Root-anchored so it cannot mask a real directory nested in a project.
/.dotnet-home/

# Package-sample restore output (test/Portico.PackageSamples restores from ./artifacts).
test/Portico.PackageSamples/**/packages/
